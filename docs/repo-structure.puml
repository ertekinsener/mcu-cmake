@startuml repo-structure
' Repository layout of mcu-cmake: a vendor-neutral core, one file per vendor
' package, and vendor code fetched from upstream git at versions chosen by
' the application.

title mcu-cmake repository / dependency structure

skinparam componentStyle rectangle
skinparam packageStyle folder

package "github.com/<you>/mcu-cmake (build infra)" as INFRA {
  package "cmake/toolchain" {
    [arm-none-eabi-gcc.cmake] as I_TC
  }
  package "cmake/mcu (vendor-neutral core)" {
    [chip.cmake\nmcu_add_chip()] as I_CHIP
    [arch/arm.cmake\nCortex-M flags] as I_ARCH
    [linker.cmake + linker/default.ld.in] as I_LD
    [package.cmake\nmcu_fetch_package()\ngit, sparse, no pinned versions] as I_PKG
    [naming.cmake\nmcu_add_named_library()\nns::name -> ALIAS] as I_NAME
    [runtime.cmake + runtime/] as I_RT
    [outputs.cmake, support_targets.cmake] as I_MISC
  }
  package "cmake/vendors/arm" {
    [cmsis_core.cmake\narm_fetch_cmsis_core()] as V_CORE
  }
  package "cmake/vendors/st" {
    [cmsis_device.cmake\nst_fetch_cmsis_device()\nst_add_cmsis_startup()] as V_DEV
    [hal.cmake\nst_fetch_hal()\nst_add_hal()] as V_HAL
  }
  package "cmake/vendors/freertos" {
    [kernel.cmake\nfreertos_fetch_kernel()\nfreertos_add_kernel()] as V_RTOS
  }
  package "cmake/vendors/threadx" {
    [kernel.cmake\nthreadx_fetch_kernel()\nthreadx_add_kernel()] as V_TX
    [filex / levelx / netxduo /\nusbx / guix .cmake\nthreadx_add_<component>(KERNEL ...)] as V_TXMW
    [common.cmake\nshared helpers] as V_TXC
  }
  package "cmake/vendors/segger" {
    [rtt.cmake\nsegger_fetch_rtt()\nsegger_add_rtt()] as V_RTT
  }
  package "cmake/vendors/<other> (future)" {
    [e.g. nxp/mcux_sdk.cmake,\nnordic/nrfx.cmake] as V_OTHER
  }
}

cloud "Upstream git (unmodified)" as UP {
  [ARM-software/CMSIS_6] as U_CORE
  [STMicroelectronics/cmsis-device-<family>] as U_DEV
  [STMicroelectronics/stm32<family>xx-hal-driver] as U_HAL
  [FreeRTOS/FreeRTOS-Kernel] as U_RTOS
  [eclipse-threadx/threadx] as U_TX
  [eclipse-threadx/filex, levelx,\nnetxduo, usbx, guix] as U_TXMW
  [SEGGERMicro/RTT] as U_RTT
}

package "github.com/<you>/firmware-xyz (application)" as APP {
  [CMakeLists.txt\nversions (GIT_TAG)\nmcu_add_chip(...)] as A_CML
  [CMakePresets.json] as A_PRESETS
  [config/stm32<family>xx_hal_conf.h\nconfig/FreeRTOSConfig.h or tx_user.h] as A_CONF
  [src/*.cc] as A_SRC
}

A_CML --> INFRA : FetchContent / add_subdirectory
A_PRESETS ..> I_TC : toolchainFile
I_CHIP ..> I_ARCH : ARCH handler
V_CORE ..> I_PKG
V_DEV ..> I_PKG
V_HAL ..> I_PKG
V_DEV ..> I_RT
V_DEV --> V_CORE
V_HAL --> V_DEV
I_PKG --> U_CORE : git, sparse
I_PKG --> U_DEV : git, sparse
I_PKG --> U_HAL : git, sparse
V_RTOS ..> I_PKG
I_PKG --> U_RTOS : git, sparse
V_TX ..> I_PKG
V_TXMW ..> V_TX : KERNEL
V_TXMW ..> V_TXC
V_TX ..> V_TXC
I_PKG --> U_TX : git, sparse
I_PKG --> U_TXMW : git, sparse
V_RTT ..> I_PKG
I_PKG --> U_RTT : git, sparse
V_OTHER ..> I_PKG

note bottom of APP
  Changing the MCU model: new mcu_add_chip() values,
  FAMILY and package versions; the core is untouched.
  Changing the vendor: another vendors/<vendor> module;
  chip, linker, outputs and runtime stay the same.
end note

@enduml
