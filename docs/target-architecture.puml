@startuml target-architecture
' CMake target graph of mcu-cmake, shown for the
' STM32H755ZI FreeRTOS example (CM4 side mirrors CM7 and is collapsed).
' The ThreadX example has the same structure with threadx_add_kernel()
' (port cortex_m7 / cortex_m4) and tx_user.h instead of FreeRTOSConfig.h;
' its CM7 image adds h755::filex_cm7, levelx_cm7, netx_cm7, usbx_cm7 and
' guix_cm7, each linked to h755::rtos_cm7 (KERNEL).
' Project libraries use namespaced aliases (h755::hal_cm7 -> h755_hal_cm7).
' Solid arrows: target_link_libraries (consumer --> dependency).
' Dotted arrows: function calls / generated files.

title CMake target architecture (STM32H755ZI dual core, FreeRTOS)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

package "cmake/toolchain" {
  [arm-none-eabi-gcc.cmake\nfinds gcc / g++ / objcopy / size\nno CPU flags] as TOOLCHAIN
}

package "cmake/mcu (vendor-neutral core)" {
  [mcu_add_chip()\nvalues from datasheet,\nvalidated, no database] as ADDCHIP
  [mcu_add_linker_script()\nconfigure_file(default.ld.in)] as ADDLD
  [mcu_add_firmware_outputs()] as OUTPUTS
  [mcu_fetch_package()\ngit, version from project] as FETCH
  [mcu_target_add_runtime()\n_init/_fini stubs, assert trap,\n-nostartfiles] as RUNTIME
  [mcu::cxx_bare_metal] as CXX
  [mcu::newlib_nano] as NANO
  [mcu::warnings] as WARN
}

package "cmake/vendors/arm + st + freertos + threadx" {
  [arm_fetch_cmsis_core()] as FETCHCORE
  [st_fetch_cmsis_device()\nst_add_cmsis_startup()] as ADDSTARTUP
  [st_fetch_hal()\nst_add_hal()] as ADDHAL
  [freertos_fetch_kernel()\nfreertos_add_kernel()] as ADDRTOS
  [threadx_fetch_kernel()\nthreadx_add_kernel()] as ADDTX
}

cloud "Upstream git\n(tags chosen in the example)" {
  [ARM-software/CMSIS_6 v6.1.0] as U_CORE
  [cmsis-device-h7 v1.10.7] as U_DEV
  [stm32h7xx-hal-driver v1.11.6] as U_HAL
  [FreeRTOS-Kernel V11.3.2] as U_RTOS
}

package "Header-only targets" {
  [arm::cmsis_core\nSYSTEM include] as CMSISCORE
  [st::cmsis_device::H7\nSYSTEM include] as CMSISDEV
}

package "Chip targets" {
  [mcu::STM32H755ZI::CM7\n-mcpu=cortex-m7 -mfpu=fpv5-d16\n-mfloat-abi=hard\nSTM32H755xx CORE_CM7\nFAMILY H7, MCU_MEMORY] as CM7CHIP
  [mcu::STM32H755ZI::CM4\n-mcpu=cortex-m4 -mfpu=fpv4-sp-d16\nSTM32H755xx CORE_CM4] as CM4CHIP
}

package "examples/common/stm32h755zi + examples/h755zi-freertos" {
  [h755::hal_conf (INTERFACE)\nstm32h7xx_hal_conf.h] as HALCONF
  [h755::freertos_conf (INTERFACE)\nFreeRTOSConfig.h] as RTOSCONF
  [h755::hal_cm7 (STATIC)\nhal, cortex, rcc, gpio,\nhsem, pwr (+ _ex)] as HAL7
  [h755::rtos_cm7 (STATIC)\nkernel, port ARM_CM4F,\nHEAP NONE] as RTOS7
  [h755::startup_cm7 (OBJECT)\nstartup_stm32h755xx.s\nsystem_..._dualcore_boot_cm4_cm7.c] as START7
  [firmware_cm7.elf] as FW7
  [firmware_cm7.ld] as LD7
  [hal_cm4 / rtos_cm4 / startup_cm4 /\nfirmware_cm4.elf\n(same structure)] as CM4SIDE
}

ADDCHIP ..> CM7CHIP : creates
ADDCHIP ..> CM4CHIP : creates
ADDHAL ..> HAL7 : creates
ADDSTARTUP ..> START7 : creates
FETCHCORE ..> FETCH
ADDTX ..> FETCH
ADDSTARTUP ..> FETCH
ADDHAL ..> FETCH
ADDRTOS ..> FETCH
ADDRTOS ..> RTOS7 : creates
FETCH ..> U_RTOS
FETCH ..> U_CORE
FETCH ..> U_DEV
FETCH ..> U_HAL
FETCHCORE ..> CMSISCORE : creates
ADDSTARTUP ..> CMSISDEV : creates
ADDSTARTUP ..> RUNTIME : uses

CMSISDEV --> CMSISCORE

HAL7 --> CM7CHIP
HAL7 --> CMSISDEV
HAL7 --> HALCONF

START7 --> CM7CHIP
START7 --> CMSISDEV
START7 --> HAL7 : HAL config\nfor system file

FW7 --> START7
FW7 --> HAL7
FW7 --> RTOS7
RTOS7 --> CM7CHIP
RTOS7 --> RTOSCONF
FW7 --> CXX
FW7 --> NANO
FW7 --> WARN

CM4SIDE --> CM4CHIP
CM4SIDE --> HALCONF
CM4SIDE --> RTOSCONF

ADDLD ..> CM7CHIP : reads MCU_MEMORY
ADDLD ..> LD7 : generates
LD7 ..> FW7 : -T, LINK_DEPENDS
OUTPUTS ..> FW7 : bin / hex / map

TOOLCHAIN -[hidden]down- ADDCHIP

note right of HAL7
  One HAL library and one FreeRTOS kernel
  per core: CM7 and CM4 need different CPU
  flags. Every user links to the same
  library, so nothing is compiled twice.
end note

@enduml
